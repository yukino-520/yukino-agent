# AGI Yukino runtime
YUKINO_HOST=127.0.0.1
YUKINO_PORT=8082
YUKINO_DATA_DIR=./data
# PostgreSQL 是唯一事实源；SQLite 仅可作为一次性旧数据导入源。
YUKINO_POSTGRES_PASSWORD=change-me
YUKINO_POSTGRES_DSN=postgresql://yukino:change-me@127.0.0.1:5433/yukino
YUKINO_DATABASE_URL=postgresql://yukino:change-me@127.0.0.1:5433/yukino
YUKINO_MODEL_PROVIDER=openai-compatible
YUKINO_TIMEZONE=Asia/Shanghai
YUKINO_CONTEXT_TOKEN_BUDGET=8000
YUKINO_QUALITY_GUARD_ENABLED=true
YUKINO_INTERACTION_LEARNING_ENABLED=true
YUKINO_INPUT_COST_PER_MILLION=0
YUKINO_OUTPUT_COST_PER_MILLION=0
YUKINO_COST_CURRENCY=USD
# 固定任务白名单；cwd 仅允许 workspace/project，命令参数不经过 Shell。
# YUKINO_SYSTEM_TASKS={"lint":{"command":[".venv/bin/python","-m","ruff","check","service_club"],"cwd":"project","timeout_seconds":120}}
YUKINO_SYSTEM_TASKS={}
# 必须使用系统级进程沙箱；只有受约束的开发/CI 环境才可显式改为 language（Doctor 会标记降级）
YUKINO_PYTHON_SANDBOX_MODE=strict

# Agent runtime and file authorization. The web settings page manages the same values.
YUKINO_AGENT_ENABLED=true
YUKINO_AGENT_MAX_STEPS=4
YUKINO_AGENT_WORKERS=2
YUKINO_AGENT_QUEUE_CAPACITY=64
YUKINO_AGENT_SESSION_QUEUE_LIMIT=3
YUKINO_TASK_WALL_TIME_SECONDS=180
YUKINO_TASK_MODEL_TOKEN_LIMIT=32768
YUKINO_TASK_MODEL_COST_LIMIT=1.0
YUKINO_TASK_TOOL_CALL_LIMIT=16
YUKINO_TASK_MODEL_CALL_LIMIT=8
YUKINO_MODEL_MAX_OUTPUT_TOKENS=2048
YUKINO_ALLOW_DESKTOP=false
YUKINO_ALLOWED_WRITE_DIRS=[]

# OpenAI-compatible model endpoint (optional; without it the app uses local fallback replies)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_MODEL=
OPENAI_TIMEOUT_SECONDS=12
YUKINO_MODEL_MAX_CONCURRENT=4
YUKINO_MODEL_CIRCUIT_FAILURES=2
YUKINO_MODEL_CIRCUIT_COOLDOWN_SECONDS=30
OPENAI_EMBEDDING_MODEL=
# Optional dedicated embedding endpoint. Blank values reuse the chat API key/base URL.
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_TIMEOUT_SECONDS=8
OPENAI_VISION_MODEL=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional media
TTS_ENABLED=false
YUKINO_TTS_VOICE_YUKINO=alloy
YUKINO_TTS_VOICE_YUI=coral
YUKINO_TTS_VOICE_HACHIMAN=onyx
YUKINO_TTS_VOICE_IROHA=nova
YUKINO_TTS_VOICE_SHIZUKA=sage
YUKINO_VIDEO_ENDPOINT=
YUKINO_VIDEO_API_KEY=

# Optional extensions and channels
YUKINO_MCP_ENDPOINTS={}
# 本机 stdio 服务需要显式开启；command 与 args 分开，整个启动过程不经过 Shell。
YUKINO_MCP_STDIO_ENABLED=false
YUKINO_MCP_STDIO_SERVERS={}
# 仅放需要显式传给对应服务的密钥；该项按秘密配置保存且不会由设置 API 回显。
YUKINO_MCP_STDIO_ENV={}
# 默认只允许公网域名；本机/内网 MCP 请优先写明确 IP。开启后才允许私网域名解析。
YUKINO_MCP_ALLOW_PRIVATE_HOSTNAMES=false
YUKINO_OUTBOUND_WEBHOOK=
YUKINO_OUTBOUND_WEBHOOK_SECRET=
YUKINO_BACKGROUND_REMINDER_DELIVERY=false
YUKINO_INBOUND_WEBHOOK_SECRET=
# auto 会仅在检测到本机代理 Fake-IP DNS 时兼容 198.18.0.0/15；设为 false 可强制关闭
YUKINO_ALLOW_FAKE_IP_DNS=auto
YUKINO_SMTP_HOST=
YUKINO_SMTP_PORT=465
YUKINO_SMTP_USERNAME=
YUKINO_SMTP_PASSWORD=
YUKINO_SMTP_SENDER=

# Required search and event data plane. PostgreSQL facts remain authoritative.
YUKINO_ELASTICSEARCH_URL=http://127.0.0.1:9201
YUKINO_ELASTICSEARCH_INDEX_PREFIX=agi_yukino
YUKINO_ELASTICSEARCH_API_KEY=
YUKINO_ELASTICSEARCH_USERNAME=
YUKINO_ELASTICSEARCH_PASSWORD=
YUKINO_ELASTICSEARCH_TIMEOUT_SECONDS=5
YUKINO_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9093
YUKINO_KAFKA_TOPIC=agi-yukino.events.v1
YUKINO_KAFKA_OUTBOX_POLL_SECONDS=0.25
YUKINO_KAFKA_OUTBOX_RETENTION_DAYS=7
YUKINO_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
YUKINO_KAFKA_SASL_MECHANISM=PLAIN
YUKINO_KAFKA_SASL_USERNAME=
YUKINO_KAFKA_SASL_PASSWORD=
YUKINO_KAFKA_SSL_CA_LOCATION=

# Optional semantic and graph projections.
YUKINO_VECTOR_BACKEND=relational
YUKINO_MILVUS_URI=http://127.0.0.1:19531
YUKINO_MILVUS_TOKEN=
YUKINO_MILVUS_DATABASE=default
YUKINO_MILVUS_COLLECTION_PREFIX=agi_yukino_memory
YUKINO_MILVUS_TIMEOUT_SECONDS=5
YUKINO_GRAPH_BACKEND=relational
YUKINO_NEO4J_URI=neo4j://127.0.0.1:7688
YUKINO_NEO4J_USERNAME=neo4j
YUKINO_NEO4J_PASSWORD=
YUKINO_NEO4J_DATABASE=neo4j

# docker-compose.storage.yml bootstrap secrets (not consumed by the app).
YUKINO_MINIO_PASSWORD=
YUKINO_NEO4J_BOOTSTRAP_PASSWORD=
